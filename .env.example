# Copy to .env (never commit .env). Tests that need these are skipped when unset.
ENV=production

# REQUIRED: the site under test. Origins only (https, no path).
TARGET_APP_URL=https://app.example.com
TARGET_SSO_URL=https://sso.example.com

# Existing account for the valid-login test
AUTH_TEST_USERNAME=
AUTH_TEST_PASSWORD=

# Mailbox you control that supports plus-addressing, e.g. test@yourdomain.com.
# Signup tests generate test+<unique>@yourdomain.com. Leave empty to skip live signup.
# Live signup also needs RUN_LIVE_SIGNUP=1 (it submits a real signup, and repeats can trigger a CAPTCHA).
RUN_LIVE_SIGNUP=
SIGNUP_BASE_EMAIL=

# Optional: path to a saved login session (default .auth/user.json, created by `npm run auth:save`)
AUTH_STORAGE_STATE=
# Optional: fail the run when more than this many tests were skipped (skips are unverified gaps)
MAX_SKIPPED=
